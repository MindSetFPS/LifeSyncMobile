# Entorno de ejecución
ENVIRONMENT=development

# Base de datos asíncrona (Singleton)
DATABASE_URL=sqlite+aiosqlite:///./lifesync.db

# Llaves RSA para firma JWT (RS256). Generar con: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Hashing de contraseñas
BCRYPT_ROUNDS=12

# OAuth 2.0 / OpenID metadata
OAUTH_ISSUER=http://localhost:8000
OAUTH_TOKEN_URL=/api/v1/auth/token
OAUTH_AUTHORIZE_URL=/api/v1/oauth/authorize
OAUTH_SUPPORTED_SCOPES=read write offline_access
OAUTH_DEFAULT_SCOPE=read write
OAUTH_AUTHORIZATION_CODE_EXPIRE_SECONDS=60

# Registro del cliente público móvil (se crea al arrancar si no existe)
OAUTH_SEED_CLIENT_ID=lifesync-android
OAUTH_SEED_CLIENT_REDIRECT_URIS=com.lifesync.mobile://oauth2callback

# Identificador de la llave de firma expuesto en JWKS (rota con la llave)
JWT_KEY_ID=lifesync-rs256-1
