# Entorno de ejecución
ENVIRONMENT=development

# Base de datos asíncrona (Singleton)
DATABASE_URL=sqlite+aiosqlite:///./lifesync.db

# Llaves RSA para firma JWT (RS256). Generar con: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Hashing de contraseñas
BCRYPT_ROUNDS=12

# OAuth 2.0
OAUTH_TOKEN_URL=/api/v1/auth/token
