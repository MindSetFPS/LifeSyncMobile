<?xml version="1.0" encoding="utf-8"?>
<!-- Producción: se bloquea tajantemente cualquier HTTP sin TLS/HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
